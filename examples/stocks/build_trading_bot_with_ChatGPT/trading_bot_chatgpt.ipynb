def _data_call_wait():
    global _LAST_DATA_CALL_TS
    with _DATA_GATE_LOCK:
        now = time.time()
        dt = now - _LAST_DATA_CALL_TS
        if dt < DATA_MIN_INTERVAL_SEC:
            time.sleep(DATA_MIN_INTERVAL_SEC - dt)
        _LAST_DATA_CALL_TS = time.time()

# ===== 4) Utilities & Logging =====
def est_now(): return datetime.now(tz)

def tick_round(px: float, tick: float = 0.01) -> float:
    if px is None or px <= 0 or tick <= 0: return px
    return round(max(px, tick), int(round(-math.log10(tick))))

def round2(x):
    try:
        v = float(x)
        if math.isnan(v) or math.isinf(v): return None
        return float(f"{v:.2f}")
    except Exception:
        return None

def ensure_trade_log():
    if not os.path.exists(TRADE_LOG_FILE):
        with _log_lock:
            if not os.path.exists(TRADE_LOG_FILE):
                with open(TRADE_LOG_FILE, "w", newline="") as f:
                    csv.writer(f).writerow(TRADE_LOG_HEADERS)

def log_trade_event(st, symbol, event, side="", qty=0, price=None, notes=""):
    ensure_trade_log()
    row = [
        est_now().isoformat(),
        st.get("trade_id",""),
        symbol,
        event,
        side,
        int(qty) if qty else 0,
        "" if price is None else round2(price),
        "" if st.get("entry_price") is None else round2(st.get("entry_price")),
        "" if (st.get("R") is None or st.get("entry_price") is None) else round2(st.get("entry_price") - st.get("R")),
        round2(st.get("cum_realized_usd", 0.0)) or 0.0,
        round2(st.get("cum_realized_R", 0.0)) or 0.0,
        notes
    ]
    try:
        with _log_lock:
            with open(TRADE_LOG_FILE, "a", newline="") as f:
                csv.writer(f).writerow(row)
    except Exception as e:
        print("[LOG] write error:", e)

def check_authorized_or_exit():
    try:
        acc = trading.get_account()
        _ = float(acc.equity)
        clk = trading.get_clock()
        print("HTTP status: 200 (authorized)")
        open_dt = clk.next_open.astimezone(tz)
        close_dt= clk.next_close.astimezone(tz)
        print(f"[SESSION] open≈{open_dt} close≈{close_dt} (is_open={clk.is_open})")
    except Exception as e:
        msg = str(e)
        if "401" in msg or "unauthorized" in msg.lower():
            print("❌ Alpaca says unauthorized (401). Check PAPER keys/plan.")
            sys.exit(1)
        print("❌ Unexpected error checking account/clock:", e)
        sys.exit(1)

def get_session_times():
    try:
        clk = trading.get_clock()
        if clk:
            return clk.next_open.astimezone(tz), clk.next_close.astimezone(tz)
    except Exception as e:
        print("[CLOCK] error:", e)
    d = est_now().date()
    return tz.localize(datetime.combine(d, dtime(9,30))), tz.localize(datetime.combine(d, dtime(16,0)))

# ---- Positions cache (≤1/s) ----
def get_positions_cached():
    now = time.time()
    with _positions_lock:
        if now - _positions_cache["ts"] < 1.0:
            return _positions_cache["by_sym"]
        try:
            pos = trading.get_all_positions()
            mp = {p.symbol: p for p in pos}
            _positions_cache["by_sym"] = mp
            _positions_cache["ts"] = now
            return mp
        except Exception:
            return _positions_cache["by_sym"]

# ---- Orders helper ----
def _list_open_orders(sym: Optional[str]=None):
    try:
        with _orders_lock:
            req = GetOrdersRequest(status=QueryOrderStatus.OPEN, nested=True)
            if sym:
                req.symbols=[sym]
            return trading.get_orders(req)
    except Exception:
        return []

def _our_order(o) -> bool:
    cid = (o.client_order_id or "")
    return cid.startswith((PFX_PARENT, PFX_TPA, PFX_TPB, PFX_STOP, PFX_STOPU))

def _cancel_order_id(oid: str):
    try:
        trading.cancel_order_by_id(oid); return True
    except Exception as e:
        print(f"[CANCEL] err {oid}: {e}")
        return False

def cancel_open_orders_targeted(symbols, *, parents=False, tps=False, stops=False, side: Optional[str]=None):
    for sym in symbols:
        try:
            oo = _list_open_orders(sym)
            for o in oo:
                if o.symbol != sym or not _our_order(o):
                    continue
                if side and (o.side or "").lower() != side.lower():
                    continue
                cid = o.client_order_id or ""
                if parents and cid.startswith(PFX_PARENT):
                    _cancel_order_id(o.id)
                elif tps and (cid.startswith(PFX_TPA) or cid.startswith(PFX_TPB)):
                    _cancel_order_id(o.id)
                elif stops and (cid.startswith(PFX_STOP) or cid.startswith(PFX_STOPU)):
                    _cancel_order_id(o.id)
        except Exception as e:
            print(f"[CANCEL] fetch open orders err for {sym}: {e}")

# ---- Data fetch with throttle & backoff ----
def _get_bars_once(req):
    _data_call_wait()
    try:
        return data.get_stock_bars(req)
    except Exception as e:
        msg = str(e)
        if "401" in msg or "unauthorized" in msg.lower():
            print("❌ DATA unauthorized (401). Check data plan/keys.")
            sys.exit(1)
        if "429" in msg or "too many requests" in msg.lower():
            delay = 1.0 + random.random()*0.8
            print(f"[DATA] 429 rate limit. Retrying after {round(delay,2)}s...")
            time.sleep(delay)
            _data_call_wait()
            try:
                return data.get_stock_bars(req)
            except Exception as e2:
                print("[DATA] retry failed:", e2)
                return None
        print(f"[DATA] error fetching bars: {e}")
        return None

def get_bars(symbol, start_dt, end_dt, tf=TimeFrame.Minute):
    # Cache TTL is longer during screening
    if tf == TimeFrame.Minute:
        now_s = time.time()
        ttl = 45.0 if _SCREENING_MODE else _bars_ttl_sec
        c = _bars_cache.get(symbol)
        if c and (now_s - c["ts"] < ttl):
            return c["df"].copy()

    req = StockBarsRequest(symbol_or_symbols=symbol, timeframe=tf, start=start_dt, end=end_dt, feed=DATA_FEED)
    bars = _get_bars_once(req)
    if bars is None or not hasattr(bars, "df"): return pd.DataFrame()
    df = bars.df.reset_index()
    if "symbol" in df.columns: df = df[df["symbol"] == symbol].copy()
    if df.empty: return df
    df["ts"] = pd.to_datetime(df["timestamp"], utc=True).dt.tz_convert(US_EASTERN_TZ)
    df = df.sort_values("ts")
    if tf == TimeFrame.Minute:
        _bars_cache[symbol] = {"ts": time.time(), "df": df}
    return df

def get_today_1m(symbol):
    now = est_now()
    start_dt = tz.localize(datetime.combine(now.date(), dtime(9,30)))
    df = get_bars(symbol, start_dt, now, TimeFrame.Minute)
    if not df.empty: df = df[df["ts"].dt.date == now.date()]
    return df

def get_daily(symbol, days=60):
    end_dt = est_now()
    start_dt = end_dt - timedelta(days=days*2)
    return get_bars(symbol, start_dt, end_dt, TimeFrame.Day)

def get_daily_batch(symbols: List[str], days=60) -> Dict[str, pd.DataFrame]:
    """Batched daily fetch to reduce API calls."""
    out: Dict[str, pd.DataFrame] = {}
    if not symbols: return out
    end_dt = est_now()
    start_dt = end_dt - timedelta(days=days*2)
    CHUNK = 80
    for i in range(0, len(symbols), CHUNK):
        chunk = symbols[i:i+CHUNK]
        req = StockBarsRequest(symbol_or_symbols=chunk, timeframe=TimeFrame.Day, start=start_dt, end=end_dt, feed=DATA_FEED)
        bars = _get_bars_once(req)
        if bars is None or not hasattr(bars, "df"): continue
        df = bars.df.reset_index()
        if df.empty: continue
        df["ts"] = pd.to_datetime(df["timestamp"], utc=True).dt.tz_convert(US_EASTERN_TZ)
        for sym in chunk:
            dfi = df[df["symbol"] == sym].copy().sort_values("ts")
            out[sym] = dfi
        time.sleep(0.03)
    return out

def ema(series, span): return series.ewm(span=span, adjust=False).mean()

def _atr_core(df):
    x = df.copy()
    x["prev_close"] = x["close"].shift(1)
    tr = pd.concat([
        (x["high"]-x["low"]).abs(),
        (x["high"]-x["prev_close"]).abs(),
        (x["low"]-x["prev_close"]).abs()
    ], axis=1).max(axis=1)
    return tr.ewm(span=14, adjust=False).mean()

def calc_atr_daily(df, length=14):
    if len(df) < length+2: return None
    atr = _atr_core(df)
    val = atr.iloc[-2]
    if pd.isna(val): return None
    return float(val)

def calc_atr_1m(df, length=ATR_LEN):
    if len(df) < length + 2: return None
    x = df.copy()
    x["prev_close"] = x["close"].shift(1)
    tr = pd.concat([
        (x["high"]-x["low"]).abs(),
        (x["high"]-x["prev_close"]).abs(),
        (x["low"]-x["prev_close"]).abs()
    ], axis=1).max(axis=1)
    atr = tr.ewm(span=length, adjust=False).mean()
    val = atr.iloc[-1]
    if pd.isna(val): return None
    return float(val)

def compute_vwap(df):
    if df.empty: return None
    typ = (df["high"] + df["low"] + df["close"]) / 3.0
    pv = (typ * df["volume"]).cumsum()
    vv = (df["volume"]).cumsum().replace(0, float("nan"))
    vwap = pv / vv
    last = vwap.iloc[-1]
    return None if pd.isna(last) else float(last)

def resample_5m(df):
    if df.empty: return pd.DataFrame()
    x = df.set_index("ts")
    agg = x[["open","high","low","close","volume"]].resample("5T").agg(
        {"open":"first","high":"max","low":"min","close":"last","volume":"sum"}).dropna()
    return agg.reset_index()

def make_coid(prefix, symbol):
