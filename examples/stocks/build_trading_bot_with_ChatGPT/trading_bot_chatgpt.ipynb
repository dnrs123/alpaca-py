# ===== 5) Universe load + sanitization =====
MAPPING_OVERRIDES = {"D-WAVE": "QBTS"}
SYMBOL_RE = re.compile(r"^[A-Z0-9\.]{1,7}$")  # allow dot (e.g., BRK.B)

def sanitize_symbol(s: str) -> Optional[str]:
    s = s.strip().upper()
    s = MAPPING_OVERRIDES.get(s, s)
    if not SYMBOL_RE.fullmatch(s): return None
    if s.endswith("Q"): return None
    return s

def load_universe():
    def _read_csv(path: pathlib.Path):
        raw = [ln.strip() for ln in path.read_text().splitlines()
               if ln.strip() and not ln.strip().startswith("#")]
        syms = []
        for r in raw:
            cleaned = sanitize_symbol(r)
            if cleaned: syms.append(cleaned)
        return list(dict.fromkeys(syms))

    candidates = []
    env_path = os.getenv("UNIVERSE_CSV_PATH", "").strip()
    if env_path: candidates.append(pathlib.Path(env_path))
    if UNIVERSE_CSV_PATH: candidates.append(pathlib.Path(UNIVERSE_CSV_PATH))
    try:
        here = pathlib.Path(__file__).resolve().parent
        candidates.append(here / "universe_watchlist.csv")
    except Exception:
        pass

    reasons = []
    for p in candidates:
        try:
            if not p.exists():
                reasons.append(f"missing: {p}"); continue
            syms = _read_csv(p)
            if syms:
                if UNIVERSE_CAP and len(syms) > UNIVERSE_CAP:
                    syms = syms[:UNIVERSE_CAP]
                print(f"[UNIVERSE] Loaded {len(syms)} symbols from CSV: {p}")
                return syms
            else:
                reasons.append(f"no valid tickers after sanitization: {p}")
        except Exception as e:
            reasons.append(f"error reading {p}: {e}")

    if reasons:
        print("[UNIVERSE] CSV load attempt(s) failed:")
        for r in reasons: print("  -", r)

    print("[UNIVERSE] Falling back to UNIVERSE_LIST.")
    base = [sanitize_symbol(s) for s in UNIVERSE_LIST]
    base = [s for s in base if s]
    if UNIVERSE_CAP and len(base) > UNIVERSE_CAP: base = base[:UNIVERSE_CAP]
    return base

# ===== 6) Screener (Two-pass: daily batch → minute refine) =====
def _safe_float(x, fallback=None):
    try:
        v = float(x)
        if math.isnan(v) or math.isinf(v): return fallback
        return v
    except (ValueError, TypeError):
        return fallback

def compute_gap_and_rvol(sym):
    dfd = get_daily(sym, days=60)
    if dfd.empty or len(dfd) < 20: return None
    dfd = dfd.sort_values("ts")
    prev_close  = _safe_float(dfd["close"].iloc[-2]) if len(dfd) >= 2 else None
    last_close_d= _safe_float(dfd["close"].iloc[-1]) if len(dfd) >= 1 else None
    if prev_close is None or prev_close <= 0 or last_close_d is None: return None
    avg20_vol = _safe_float(dfd["volume"].iloc[-20:].mean(), 0.0)

    df1 = get_today_1m(sym)
    if df1.empty:
        last_price = last_close_d; cum_vol = 0.0
    else:
        last_price = _safe_float(df1["close"].iloc[-1]) or last_close_d
        cum_vol = _safe_float(df1["volume"].sum(), 0.0)

    if last_price is None or last_price <= 0: return None
    gap_pct = (last_price / prev_close - 1.0) if prev_close > 0 else 0.0

    current_time_fraction = expected_intraday_fraction(est_now().time())
    baseline_volume = max((avg20_vol or 0.0) * current_time_fraction, 1.0)
    rvol_adj = (cum_vol / baseline_volume) if baseline_volume > 0 else 0.0

    atrD = calc_atr_daily(dfd, 14)
    atrD_pct = (atrD / last_price) if (atrD and last_price > 0) else None

    return {"last_price":last_price, "gap_pct":gap_pct, "rvol_adj":rvol_adj,
            "avg20_vol":avg20_vol, "atrD_pct":atrD_pct}

def screen_candidates():
    global _SCREENING_MODE
    base = load_universe()
    if UNIVERSE_CAP and len(base) > UNIVERSE_CAP:
        base = base[:UNIVERSE_CAP]
    print(f"[SCREEN] Universe size: {len(base)}. Scanning …")

    _SCREENING_MODE = True  # extend cache TTL while we screen

    # ----- PASS A: daily prefilter (batched) -----
    rowsA = []
    daily_map = get_daily_batch(base, days=60)
    for sym in base:
        dfd = daily_map.get(sym)
        if dfd is None or dfd.empty or len(dfd) < 20: continue
        prev_close = _safe_float(dfd["close"].iloc[-2])
        last_close_d = _safe_float(dfd["close"].iloc[-1])
        if prev_close is None or prev_close <= 0 or last_close_d is None: continue
        price_hint = last_close_d
        adv20 = _safe_float(dfd["volume"].iloc[-20:].mean(), 0.0)
        atrD  = calc_atr_daily(dfd, 14)
        atrD_pct = (atrD / last_close_d) if (atrD and last_close_d > 0) else None
        if price_hint is None or atrD_pct is None: continue
        if not (MIN_PRICE <= price_hint <= MAX_PRICE): continue
        if (adv20 or 0.0) < MIN_AVG_DAILY_VOL: continue
        rough_gap = (last_close_d / prev_close - 1.0) if prev_close > 0 else 0.0
        if rough_gap < (MIN_GAP_PCT * 0.6):  # looser than final filter
            continue
        rowsA.append({"symbol": sym, "price": price_hint, "atrD_pct": atrD_pct, "adv20": adv20, "rough_gap": rough_gap})
        if len(rowsA) % 50 == 0: time.sleep(0.05)

    if not rowsA:
        _SCREENING_MODE = False
        print("[SCREEN] No daily-prefilter matches. Fallback to first 10.")
        return base[:10]

    prelim = pd.DataFrame(rowsA).sort_values("rough_gap", ascending=False)
    finalists = list(prelim["symbol"].head(60).values)  # refine intraday on ≤60

    # ----- PASS B: minute refinement -----
    rowsB = []
    for sym in finalists:
        try:
            m = compute_gap_and_rvol(sym)
            if not m: continue
            p = m["last_price"]; gap = m["gap_pct"]; rv = m["rvol_adj"]; adv = m["avg20_vol"]; atrp = m["atrD_pct"]
            if p is None or atrp is None: continue
            if not (MIN_PRICE <= p <= MAX_PRICE): continue
            if (adv or 0.0) < MIN_AVG_DAILY_VOL: continue
            if gap < MIN_GAP_PCT: continue
            if rv < MIN_RVOL_ADJ: continue
            if not (MIN_ATR_D_PCT <= atrp <= MAX_ATR_D_PCT): continue
            score = (gap*100) * rv
            rowsB.append({"symbol": sym, "price": p, "gap_pct": gap, "rvol_adj": rv, "atrD_pct": atrp, "score": score})
        except Exception:
            pass
        time.sleep(0.02)

    _SCREENING_MODE = False

    if not rowsB:
        print("[SCREEN] No intraday matches. Fallback to daily shortlist head.")
        return prelim["symbol"].head(min(10, len(prelim))).tolist()

    df = pd.DataFrame(rowsB).sort_values("score", ascending=False)
    picks = list(df["symbol"].head(CANDIDATE_LIMIT).values)
    print(f"[SCREEN] Found {len(picks)} candidates. Top picks: {picks}")
    try:
        print("--- Top 10 Screened Candidates ---")
        print(df.head(min(10, len(df)))[["symbol","price","gap_pct","rvol_adj","atrD_pct","score"]].to_string(index=False))
        print("----------------------------------")
    except Exception:
        pass
    return picks

# ===== 7) Strategy core =====
def run_symbol(sym):
    state[sym] = {
        "trade_id": None,
        "trades_count": 0, "last_trade_time": None,
        "open_parent_id": None, "position_qty": 0, "avg_price": None,
        "filled": False, "tpA_id": None, "tpB_id": None,
        "tpA_done": False, "tpB_done": False,
        "tpA_qty": 0, "tpB_qty": 0,
        "stop_id": None, "stop_last_set": 0.0,
        "last_stop_px": None, "last_stop_qty": 0,
        "entry_price": None, "R": None, "risk_usd_dyn": None,
        "cum_realized_usd": 0.0, "cum_realized_R": 0.0,
        "tpA_last_filled": 0.0, "tpB_last_filled": 0.0,
        "stop_last_filled": 0.0
    }

    mkt_open, mkt_close = get_session_times()
    print(f"[INIT] {sym} | open≈{mkt_open.time()} close≈{mkt_close.time()}")

    while not STOP_EVENT.is_set():
        now = est_now()
        if now < mkt_open:
            time.sleep(PRINT_EVERY_SEC); continue

        # EOD flatten window
        if now >= (mkt_close - timedelta(minutes=FORCE_EXIT_MIN)):
            _force_flat(sym); break

        # Manage lifecycle
        manage_open_lifecycle(sym)

        # Entry windows / limits
        if now >= (mkt_close - timedelta(minutes=ENTRY_CUTOFF_MIN)) or not in_trade_windows(now):
            time.sleep(PRINT_EVERY_SEC); continue
        st = state[sym]
        if st["trades_count"] >= MAX_TRADES_PER_DAY: time.sleep(PRINT_EVERY_SEC); continue
        if st["last_trade_time"] and now - st["last_trade_time"] < timedelta(minutes=COOLDOWN_MIN):
            time.sleep(PRINT_EVERY_SEC); continue
        if cluster_blocked(sym): time.sleep(PRINT_EVERY_SEC); continue

        # Portfolio open risk cap (rough)
        if current_open_risk_estimate() + (st.get("risk_usd_dyn") or 1000) > MAX_PORTFOLIO_OPEN_RISK:
            time.sleep(PRINT_EVERY_SEC); continue

        # Data
        df = get_today_1m(sym)
        if len(df) < max(VOLUME_LOOKBACK+2, ATR_LEN+2, 16):
            time.sleep(PRINT_EVERY_SEC); continue

        # Regime filter
        if USE_REGIME_FILTER:
            dfq = get_cached_qqq()
            if not dfq.empty:
                vwap_q = compute_vwap(dfq)
                q_now = dfq["close"].iloc[-1]
                q_open = dfq["open"].iloc[0]
                if vwap_q and REGIME_WEAK_SKIP and (q_now < vwap_q) and ((q_now/q_open - 1.0) <= REGIME_WEAK_DROP_PCT):
                    time.sleep(PRINT_EVERY_SEC); continue

        # Intraday context
        prev_high_of_day = float(df.iloc[:-1]["high"].max())
        last_bar = df.iloc[-1]
        last_high = float(last_bar["high"]); last_close = float(last_bar["close"])
        last_open = float(last_bar["open"]); last_low = float(last_bar["low"]); last_vol = float(last_bar["volume"])

        # Volume baseline
        lookback = df.iloc[-(VOLUME_LOOKBACK+1):-1]
        avg_vol  = float(lookback["volume"].mean()) if not lookback.empty else 0.0

        # ATR sanity
        atr = calc_atr_1m(df)
        if atr is None: time.sleep(PRINT_EVERY_SEC); continue
        atr_pct = atr / max(last_close, 1e-6)
        if atr_pct < ATR_PCT_MIN or atr_pct > ATR_PCT_MAX: time.sleep(PRINT_EVERY_SEC); continue

        # VWAP filter
        if USE_VWAP_FILTER:
            vwap = compute_vwap(df)
            if vwap is None or last_close < vwap:
                time.sleep(PRINT_EVERY_SEC); continue

        # Breakout condition
        buffer = max(0.01, (BUFFER_BPS/10000.0) * prev_high_of_day)
        broke = (last_high > prev_high_of_day + buffer)
        if REQUIRE_CLOSE_ABOVE:
            broke = broke and (last_close > prev_high_of_day + buffer)
        if not broke: time.sleep(PRINT_EVERY_SEC); continue

        # Volume filter on breakout bar
        vol_ok = (avg_vol <= 1) or (last_vol >= VOLUME_MULTIPLIER * avg_vol)
        if not vol_ok: time.sleep(PRINT_EVERY_SEC); continue

        # Levels & dynamic risk
        stop_dist_atr = ATR_MULT * atr if atr and atr > 0 else 0.0
        pct_stop      = STOP_PCT_FLOOR * last_close
        stop_dist     = max(stop_dist_atr, pct_stop, 0.02)  # enforce >= 2 ticks
        entry_trig    = prev_high_of_day + buffer
        stop_price    = max(entry_trig - stop_dist, 0.01)
        R             = entry_trig - stop_price
        if R <= 0: time.sleep(PRINT_EVERY_SEC); continue

        # Dynamic risk
        try:
            equity = float(trading.get_account().equity)
        except Exception:
            equity = 100000.0
        risk_usd_dyn = equity * RISK_EQUITY_PCT
        if atr_pct >= HIGH_ATR_THRESH: risk_usd_dyn *= HIGH_ATR_RISK_SCALE
        risk_usd_dyn = max(min(risk_usd_dyn, RISK_USD_MAX), RISK_USD_MIN)

        def calc_qty(entry, stop, risk_usd):
            rps = max(float(entry) - float(stop), 0.01) + SLIPPAGE_CENTS_MODEL/100.0
            return max(math.floor(risk_usd / rps), 0)

        qty = calc_qty(entry_trig, stop_price, risk_usd_dyn)
        if qty <= 0: time.sleep(PRINT_EVERY_SEC); continue

        # Parent order — marketable limit with ladder fallback
        st["trade_id"] = make_coid(PFX_PARENT, sym)
        st["R"] = R; st["entry_price"] = entry_trig
        st["risk_usd_dyn"] = risk_usd_dyn

        if PLACE_ORDERS:
            try:
                cancel_open_orders_targeted([sym], parents=True, side="buy")

                limit_px = tick_round(entry_trig * (1.0 + MAX_ENTRY_SLIP))
                parent = LimitOrderRequest(
                    symbol=sym, qty=qty, side=OrderSide.BUY,
                    time_in_force=TimeInForce.DAY,
                    limit_price=limit_px,
                    client_order_id=st["trade_id"],
                )
                resp = trading.submit_order(parent)
                st["open_parent_id"] = resp.id
                st["trades_count"] += 1; st["last_trade_time"] = est_now()
                log_trade_event(st, sym, "entry_submit", side="BUY", qty=qty, price=limit_px,
                                notes=f"trig={round2(entry_trig)}, stop_ref={round2(stop_price)}")
                print(f"[ORDER] Parent LIMIT sent {sym} id={resp.id} px={limit_px}")

                # ladder if not filled within small window and price stays > trig
                ladder_start = time.time()
                ladder_idx = 0
                while ladder_idx < len(ENTRY_LADDER_STEPS):
                    time.sleep(1.5)
                    status, fqty, favg = _get_order_fill(resp.id)
                    if status in ("filled","partially_filled"): break
                    if time.time() - ladder_start >= LADDER_RETRY_SEC:
                        ladder_start = time.time()
                        ladder_idx += 1
                        bump = ENTRY_LADDER_STEPS[ladder_idx-1]
                        new_px = tick_round(entry_trig*(1.0+bump))
                        _cancel_order_id(resp.id)
                        time.sleep(0.3)
                        parent2 = LimitOrderRequest(
                            symbol=sym, qty=qty, side=OrderSide.BUY,
                            time_in_force=TimeInForce.DAY, limit_price=new_px,
                            client_order_id=make_coid(PFX_PARENT, sym)
                        )
                        resp = trading.submit_order(parent2)
                        st["open_parent_id"] = resp.id
                        print(f"[ORDER] Parent LIMIT ladder {sym} px={new_px}")
            except Exception as e:
                print("[ERROR] LIMIT entry failed:", e)

        time.sleep(PRINT_EVERY_SEC)

    print(f"[END] {sym} loop stopped.")

# ----- lifecycle / children / trailing -----
def _get_order_fill(order_id) -> Tuple[Optional[str], float, float]:
    try:
        o = trading.get_order_by_id(order_id)
        if not o: return None, 0.0, 0.0
        status = o.status
        filled_qty = float(o.filled_qty or 0)
        filled_avg = float(o.filled_avg_price or 0)
        return status, filled_qty, filled_avg
    except Exception:
        return None, 0.0, 0.0

def _apply_realized_incremental(st, symbol, qty_new_fill: float, fill_price: float):
    entry = st.get("entry_price"); R = st.get("R")
    if entry is None or R is None or R == 0 or qty_new_fill <= 0: return
    per_share = float(fill_price) - float(entry)  # long exits
    realized_usd = per_share * qty_new_fill
    st["cum_realized_usd"] = (st.get("cum_realized_usd", 0.0) or 0.0) + realized_usd
    per_share_R = per_share / R
    base_qty = max(st.get("position_qty", qty_new_fill), 1.0)
    st["cum_realized_R"] = (st.get("cum_realized_R", 0.0) or 0.0) + (per_share_R * (qty_new_fill / base_qty))

def place_children(sym):
    st = state[sym]
    qty = int(st["position_qty"]); entry = st["entry_price"]; R = st["R"]
    if qty <= 0 or entry is None or R is None: return

    tpA = entry + TP_A * R
    tpB = entry + TP_B * R
    tpC = entry + TP_C * R  # info only
    for nm, val in [("tpA",tpA),("tpB",tpB),("tpC",tpC)]:
        if val is None or math.isinf(val) or math.isnan(val) or val <= 0:
            print(f"[CHILD] invalid {nm} for {sym}. Skipping children."); return

    # split thirds; ensure runner >=1 if qty>0
    qA = int(math.floor(qty * (1/3)))
    qB = int(math.floor(qty * (1/3)))
    qC = int(qty - qA - qB)
    if qC == 0 and qty > 0:
        if qB > 0: qB -= 1; qC = 1
        elif qA > 0: qA -= 1; qC = 1
        else: qC = 1

    try:
        time.sleep(0.25)
        if qA > 0:
            oA = trading.submit_order(LimitOrderRequest(
                symbol=sym, qty=qA, side=OrderSide.SELL,
                time_in_force=TimeInForce.DAY,
                limit_price=tick_round(tpA),
                client_order_id=make_coid(PFX_TPA, sym)
            )); st["tpA_id"] = oA.id; st["tpA_qty"] = qA; log_trade_event(st, sym, "tpA_submit", side="SELL", qty=qA, price=tpA)

        if qB > 0:
            oB = trading.submit_order(LimitOrderRequest(
                symbol=sym, qty=qB, side=OrderSide.SELL,
                time_in_force=TimeInForce.DAY,
                limit_price=tick_round(tpB),
                client_order_id=make_coid(PFX_TPB, sym)
            )); st["tpB_id"] = oB.id; st["tpB_qty"] = qB; log_trade_event(st, sym, "tpB_submit", side="SELL", qty=qB, price=tpB)

        # Protective STOP for runner only
        df_now = get_today_1m(sym)
        atr_1m = calc_atr_1m(df_now) if not df_now.empty else None
        atr_dist = (ATR_MULT * atr_1m) if atr_1m and atr_1m > 0 else (R)
        raw_stop = entry - max(atr_dist, STOP_PCT_FLOOR*entry)
        last_price = float(df_now["close"].iloc[-1]) if not df_now.empty else entry
        stop_init = min(tick_round(max(raw_stop, 0.01)), last_price - 0.01)

        if qC > 0:
            os_ = trading.submit_order(StopOrderRequest(
                symbol=sym, qty=qC, side=OrderSide.SELL,
                time_in_force=TimeInForce.DAY,
                stop_price=stop_init,
                client_order_id=make_coid(PFX_STOP, sym)
            ))
            st["stop_id"] = os_.id
            st["stop_last_set"] = time.time()
            st["last_stop_px"] = stop_init
            st["last_stop_qty"] = qC
            log_trade_event(st, sym, "stop_submit", side="SELL", qty=qC, price=stop_init)

        print(f"[CHILD] {sym} TP: {round2(tpA)}/{round2(tpB)} | Runner TP≈{round2(tpC)} | SL={round2(stop_init)} (qty {qC})")

    except Exception as e:
        print(f"[CHILD] error {sym}:", e)

def _open_qty_for_order(oid):
    try:
        o = trading.get_order_by_id(oid)
        if not o: return 0,0,""
        total = float(o.qty or 0)
        filled = float(o.filled_qty or 0)
        return max(int(total - filled), 0), int(filled), o.status
    except Exception:
        return 0,0,""

def _sum_open_qty_for(prefixes, sym):
    total = 0
    for o in _list_open_orders(sym):
        if o.symbol != sym or not _our_order(o): continue
        cid = o.client_order_id or ""
        if any(cid.startswith(p) for p in prefixes):
            oq, fq, stt = _open_qty_for_order(o.id)
            if stt not in ("filled","canceled","expired","rejected"):
                total += oq
    return int(total)

def _recalc_stop_qty(sym, pos_qty):
    open_tp_qty = _sum_open_qty_for([PFX_TPA, PFX_TPB], sym)
    stop_qty_target = int(max(pos_qty - open_tp_qty, 0))
    return stop_qty_target, _sum_open_qty_for([PFX_STOP, PFX_STOPU], sym)

def _cancel_existing_stops(sym):
    cancel_open_orders_targeted([sym], stops=True, side="sell")
    t0 = time.time()
    while time.time() - t0 < 2.0:
        if _sum_open_qty_for([PFX_STOP, PFX_STOPU], sym) == 0: break
        time.sleep(0.1)

def _replace_stop(sym, qty, new_stop_px, note):
    if qty <= 0: return
    _cancel_existing_stops(sym)
    try:
        so = trading.submit_order(StopOrderRequest(
            symbol=sym, qty=int(qty), side=OrderSide.SELL,
            time_in_force=TimeInForce.DAY,
            stop_price=tick_round(new_stop_px),
            client_order_id=make_coid(PFX_STOPU, sym)
        ))
        st = state[sym]
        st["stop_id"] = so.id
        st["stop_last_set"] = time.time()
        st["last_stop_px"] = new_stop_px
        st["last_stop_qty"] = int(qty)
        log_trade_event(st, sym, "stop_replace", side="SELL", qty=int(qty), price=new_stop_px, notes=note)
    except Exception as e:
        print(f"[SL] replace err {sym}: {e}")

def _track_partial_fill(st, sym, oid, tag_key):
    status, fqty, favg = _get_order_fill(oid)
    last_key = f"{tag_key}_last_filled"
    prev = float(st.get(last_key, 0.0) or 0.0)
    if fqty > prev:
        delta = fqty - prev
        _apply_realized_incremental(st, sym, delta, favg)
        st[last_key] = fqty
        if status == "filled":
            log_trade_event(st, sym, f"{tag_key}_fill", side="SELL", qty=fqty, price=favg)
    return status

def monitor_children_and_trail(sym):
    st = state[sym]
    entry = st["entry_price"]; R = st["R"]
    if entry is None or R is None: return

    pos_map = get_positions_cached()
    pos = pos_map.get(sym)
    remaining_qty = int(float(pos.qty)) if pos else 0

    df = get_today_1m(sym)
    if df.empty: return
    last_price = float(df["close"].iloc[-1])
    atr = calc_atr_1m(df) or (R/ATR_MULT)

    # Track TP partials/finals
    if st.get("tpA_id") and not st.get("tpA_done"):
        if _track_partial_fill(st, sym, st["tpA_id"], "tpA") == "filled":
            st["tpA_done"] = True; st["tpA_qty"] = 0
    if st.get("tpB_id") and not st.get("tpB_done"):
        if _track_partial_fill(st, sym, st["tpB_id"], "tpB") == "filled":
            st["tpB_done"] = True; st["tpB_qty"] = 0

    # Track STOP partials/final
    if st.get("stop_id"):
        _track_partial_fill(st, sym, st["stop_id"], "stop")
        status, fqty, favg = _get_order_fill(st["stop_id"])
        if status == "filled":
            log_trade_event(st, sym, "stop_filled_all", side="SELL", qty=fqty, price=favg)
            st["stop_id"] = None

    # Compute desired stop (runner-only) and size
    if remaining_qty > 0:
        if last_price >= entry + TRAIL_START_R * R:
            new_stop_px = max(entry, last_price - TRAIL_ATR_MULT*atr); note = "trail_after_1R"
        else:
            new_stop_px = max(entry - max(ATR_MULT*atr, STOP_PCT_FLOOR*entry), 0.01); note = "protective"
        new_stop_px = min(new_stop_px, last_price - 0.01)
        stop_qty_target, open_stop_qty = _recalc_stop_qty(sym, int(remaining_qty))

        now_s = time.time()
        price_move = abs((st.get("last_stop_px") or 0) - new_stop_px)
        qty_changed = (stop_qty_target != st.get("last_stop_qty", -1))
        if stop_qty_target > 0 and (qty_changed or price_move >= 0.05*R) and (now_s - (st.get("stop_last_set") or 0)) >= 3.0:
            if stop_qty_target != open_stop_qty or price_move >= 0.05*R:
                _replace_stop(sym, stop_qty_target, new_stop_px, note)

    # Flat cleanup
    if remaining_qty == 0 and st["filled"]:
        pnl_R = st.get("cum_realized_R", 0.0) or 0.0
        update_day_stats(pnl_R)
        log_trade_event(st, sym, "exit_flat", side="SELL", qty=0, price=last_price,
                        notes=f"final_R={round2(pnl_R)} realized=${round2(st.get('cum_realized_usd',0))}")
        reset_symbol(sym)
        print(f"[EXIT] {sym} flat. Cum ≈ {round2(st.get('cum_realized_R',0.0))}R / ${round2(st.get('cum_realized_usd',0.0))}")

def update_day_stats(pnl_R):
    global DAY_REALIZED_R, CONSEC_LOSSES
    DAY_REALIZED_R += (pnl_R or 0.0)
    if (pnl_R or 0.0) <= 0: CONSEC_LOSSES += 1
    else: CONSEC_LOSSES = 0
    if DAY_REALIZED_R <= MAX_DAILY_LOSS_R or CONSEC_LOSSES >= MAX_CONSEC_LOSSES:
        print(f"[KILL] Guardrail hit (R={DAY_REALIZED_R}, losses={CONSEC_LOSSES}). Flatten all.")
        STOP_EVENT.set(); global_flatten_all()

def reset_symbol(sym):
    st = state[sym]
    st.update({"open_parent_id":None,"position_qty":0,"avg_price":None,"filled":False,
               "tpA_id":None,"tpB_id":None,"tpA_done":False,"tpB_done":False,
               "tpA_qty":0,"tpB_qty":0,
               "stop_id":None,"stop_last_set":0.0,"last_stop_px":None,"last_stop_qty":None,
               "entry_price":None,"R":None,
               "cum_realized_usd":0.0,"cum_realized_R":0.0,"trade_id":None,
               "tpA_last_filled":0.0,"tpB_last_filled":0.0,"stop_last_filled":0.0})

def _force_flat(sym):
    st = state.get(sym, {})
    try:
        cancel_open_orders_targeted([sym], parents=True, tps=True, stops=True)
        positions = get_positions_cached()
        pos = positions.get(sym)
        if pos and float(pos.qty) > 0:
            print(f"[EOD] Force closing {sym} qty={pos.qty}")
            for _ in range(3):
                try:
                    trading.close_position(sym); break
                except Exception as e:
                    print(f"[EOD] close error {sym}: {e}")
                    time.sleep(0.4)
        log_trade_event(st, sym, "force_flat", side="SELL", qty=0, price=None, notes="EOD")
        reset_symbol(sym)
    except Exception as e:
        print(f"[EOD] flat error {sym}:", e)

def global_flatten_all():
    print("[FLATTEN] Initiating global flatten for all positions.")
    try:
        STOP_EVENT.set()
        syms = set()
        for o in _list_open_orders():
            if _our_order(o): syms.add(o.symbol)
        if syms:
            cancel_open_orders_targeted(list(syms), parents=True, tps=True, stops=True)
        pos = get_positions_cached()
        symbols_to_flatten = [s for s,p in pos.items() if float(p.qty) != 0.0]
        for p_sym in symbols_to_flatten:
            for _ in range(3):
                try:
                    trading.close_position(p_sym)
                    print(f"[FLAT] close submitted {p_sym}")
                    break
                except Exception as e:
                    print(f"[FLAT] error closing {p_sym}: {e}")
                    time.sleep(0.4)
        print("[FLATTEN] Attempts complete.")
    except Exception as e:
        print(f"[FLAT] global flatten error: {e}")

# ===== 8) Main =====
def main():
    ensure_trade_log()
    check_authorized_or_exit()
    mkt_open, mkt_close = get_session_times()
    print(f"[SESSION] open≈{mkt_open} close≈{mkt_close}")

    # Wait until SCAN_AT (post open) to build candidates
    while est_now().time() < SCAN_AT and not STOP_EVENT.is_set():
        time.sleep(1)

    if USE_DYNAMIC_SCREENER:
        picks = screen_candidates()
    else:
        picks = load_universe()[:CANDIDATE_LIMIT]
        print("[SCREEN] Dynamic screener OFF. Using:", picks)

    if not picks:
        print("No picks today. Exiting.")
        return

    running: Dict[str, Thread] = {}
    for sym in picks:
        t = Thread(target=run_symbol, args=(sym,), daemon=True)
        t.start(); running[sym] = t; time.sleep(0.25)

    last_rescan = est_now()
    try:
        while any(t.is_alive() for t in running.values()):
            now = est_now()
            _, close_ = get_session_times()
            if now >= (close_ - timedelta(minutes=FORCE_EXIT_MIN)):
                print("[MAIN] EOD approaching, flattening all.")
                global_flatten_all(); break

            # periodic light rescan (spawn only new)
            if (now - last_rescan) >= timedelta(minutes=RESCAN_EVERY_MIN) and USE_DYNAMIC_SCREENER:
                last_rescan = now
                try:
                    more = screen_candidates()
                    for sym in more:
                        if sym not in running:
                            tt = Thread(target=run_symbol, args=(sym,), daemon=True)
                            tt.start(); running[sym] = tt; time.sleep(0.25)
                except Exception as e:
                    print("[RESCAN] error:", e)

            time.sleep(1)
    except KeyboardInterrupt:
        print("KeyboardInterrupt: Flatten & stop.")
        global_flatten_all()

    for sym, t in list(running.items()):
        try: t.join(timeout=1.0)
        except Exception: pass
    print("[DONE] Log saved to:", TRADE_LOG_FILE)

if __name__ == "__main__":
    main()
